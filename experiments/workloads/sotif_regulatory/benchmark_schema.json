{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AEP Regulatory QA Benchmark",
  "type": "object",
  "required": ["schema", "items"],
  "properties": {
    "schema": {"const": "aep-regulatory-benchmark-v1"},
    "corpus": {
      "type": "object",
      "properties": {
        "name": {"type": "string"},
        "redistributable": {"type": "boolean"},
        "notes": {"type": "string"}
      },
      "additionalProperties": true
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "question",
          "task_type",
          "answerable",
          "evidence_catalog",
          "gold_evidence_ids"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "question": {"type": "string", "minLength": 1},
          "scenario": {"type": "string"},
          "task_type": {
            "type": "string",
            "enum": [
              "single_clause",
              "multi_hop_intra_document",
              "cross_document",
              "definition_requirement",
              "requirement_exception",
              "version_applicability",
              "conflicting_evidence",
              "unanswerable"
            ]
          },
          "answerable": {"type": "boolean"},
          "gold_answer": {"type": ["string", "null"]},
          "minimum_hops": {"type": "integer", "minimum": 0},
          "evidence_catalog": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "evidence_id",
                "document_id",
                "version",
                "locator",
                "redistributable"
              ],
              "properties": {
                "evidence_id": {"type": "string"},
                "document_id": {"type": "string"},
                "version": {"type": "string"},
                "locator": {"type": "string"},
                "title": {"type": "string"},
                "text": {"type": "string"},
                "redistributable": {"type": "boolean"},
                "source_uri": {"type": "string"}
              },
              "additionalProperties": false
            }
          },
          "gold_evidence_ids": {
            "type": "array",
            "items": {"type": "string"}
          },
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
